# Copia este archivo como secrets.properties (esta en .gitignore) y completa los valores.
# Tambien se pueden usar variables de entorno con el mismo nombre en mayusculas
# (APP_SHEETS_DEPLOY_ID, APP_SHEETS_SCRIPT_KEY, APP_SECURITY_API_KEY).

# ID de implementacion del Apps Script (vacio = modo local con data/db.json)
app.sheets.deploy-id=

# Clave API_KEY del Apps Script (se obtiene ejecutando generarClave() en el editor)
app.sheets.script-key=

# Clave que el frontend debe enviar a este backend (X-Api-Key)
app.security.api-key=
